PORT=4187
DATABASE_URL=
DATABASE_SSL=
PGLITE_PATH=
AUTH_REQUIRED=false
ADMIN_PASSWORD=
JWT_SECRET=change-me-before-production
INVITE_CODE=
# Set true only for the single original author to import from local /Downloads files.
ALLOW_LOCAL_IMPORT=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Per-stage routing (balanced ladder: cheap utility, strong voice, premium on demand).
# These are examples verified during the 2026-06 model audit; any OpenRouter slug works.
MODEL_PROFILE=balanced
MODEL_FRAME=z-ai/glm-5.2
MODEL_DRAFT=anthropic/claude-sonnet-4.6
MODEL_SHARPEN=anthropic/claude-sonnet-4.6
MODEL_REFINE=anthropic/claude-sonnet-4.6
MODEL_REPURPOSE=anthropic/claude-sonnet-4.6
MODEL_DISCOVER=google/gemini-3.1-flash-lite
MODEL_SEO=google/gemini-3.1-flash-lite
MODEL_SWARM=google/gemini-3.1-flash-lite
MODEL_VISUAL_PROMPT=google/gemini-3.1-flash-lite
MODEL_SIGNALS_DEEPDIVE=z-ai/glm-5.2
MODEL_SIGNALS_MACRO=google/gemini-3.1-flash-lite
MODEL_FINTEL_BRIDGE=z-ai/glm-5.2
MODEL_SYNTHESIS=anthropic/claude-sonnet-4.6
MODEL_REVIEWGATE=z-ai/glm-5.2
MODEL_STORY=anthropic/claude-sonnet-4.6
MODEL_CRITIC=anthropic/claude-sonnet-4.6
MODEL_STUDY_SKILL=google/gemini-3.1-flash-lite
MODEL_IMAGE=google/gemini-3-pro-image
# Per-image cost estimate (USD) used for telemetry when the images response omits cost.
# IMAGE_COST_USD=0.04

EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
ENABLE_PROMPT_CACHE=true

# OpenRouter Fusion server tool (parallel model panel + judge) for multi-perspective stages.
# Empty FUSION_STAGES = Fusion runs only via the manual "Deep Sharpen" button.
FUSION_STAGES=
FUSION_FORCE=false
FUSION_PANEL=z-ai/glm-5.2,anthropic/claude-sonnet-4.6,anthropic/claude-opus-4.8
FUSION_JUDGE_MODEL=

# Per-stage execution (any PromptStage; hyphens become underscores, uppercased).
# MODE_<STAGE>=chat|fusion|web_search   TEMP_<STAGE>=0.0-1.0   MAXTOK_<STAGE>=<int>
# Example (The Grid signal stages):
# MODE_SIGNALS_DEEPDIVE=fusion
# MODE_SIGNALS_MACRO=web_search
# TEMP_STORY=0.8
# Web-search plugin defaults (used when a stage's MODE=web_search):
WEB_ENGINE=exa
WEB_MAX_RESULTS=6
