PORT=4187
DATABASE_URL=
DATABASE_SSL=
PGLITE_PATH=
AUTH_REQUIRED=false
ADMIN_PASSWORD=
ADMIN_TOKEN=
JWT_SECRET=change-me-before-production
INVITE_CODE=
DEFAULT_DAILY_COST_LIMIT_USD=
DEFAULT_MONTHLY_COST_LIMIT_USD=
# Set true only for the single original author to import from local /Downloads files.
ALLOW_LOCAL_IMPORT=false

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model routing. MODEL_PROFILE drives every text stage:
#   cost-first (default) = bakeoff-validated cheap models everywhere but Deep Sharpen
#   balanced             = cheap structuring, strong voice (draft/sharpen/refine/story)
#   premium              = strong everywhere, Opus on sharpen/story/critic
# Leave per-stage MODEL_<STAGE> UNSET so the profile + the Labs switch are the single
# source of truth; set one only to pin a single stage to a specific model.
MODEL_PROFILE=cost-first
# MODEL_DRAFT=anthropic/claude-sonnet-4.6   # example pin (overrides the profile for one stage)
MODEL_SWARM=google/gemini-3.1-flash-lite
# Images are tiered by MODEL_PROFILE too (cost-first = Nano Banana 2 Lite ~$0.04/image,
# balanced = Nano Banana 2 ~$0.08, premium = Nano Banana Pro ~$0.155). Leave MODEL_IMAGE
# UNSET so the profile governs — pinning it here is what kept every image on the
# premium tier regardless of the profile.
# MODEL_IMAGE=google/gemini-3.1-flash-lite-image
# The persona anchor is the single reference every Veo shot inherits, so it stays on
# the premium tier by default (generated once per persona, then cached and reused).
# MODEL_IMAGE_ANCHOR=google/gemini-3-pro-image
# Pictures can also come from Cloudflare Workers AI (FLUX.1 [schnell], free inside its
# 10,000-neuron daily allowance, ~96 neurons an image). Set both to offer it; the motion
# story Pictures panel then lets the writer choose. Token: Cloudflare dashboard > My
# Profile > API Tokens > "Workers AI" template.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Make every image (covers, keyframes, motion pictures) default to Cloudflare:
# IMAGE_PROVIDER=cloudflare
# MODEL_IMAGE_CLOUDFLARE=@cf/black-forest-labs/flux-1-schnell
# Per-image cost fallback (USD) when the images response omits cost. Unset now falls
# back to a per-tier estimate so spend caps can never under-count image generation.
# IMAGE_COST_USD=0.04

EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
ENABLE_PROMPT_CACHE=true

# OpenRouter Fusion server tool (parallel model panel + judge) for multi-perspective stages.
# Empty FUSION_STAGES = Fusion runs only via the manual "Deep Sharpen" button.
FUSION_STAGES=
FUSION_FORCE=false
FUSION_PANEL=z-ai/glm-5.2,anthropic/claude-sonnet-4.6,anthropic/claude-opus-4.8
FUSION_JUDGE_MODEL=

# Per-stage execution (any PromptStage; hyphens become underscores, uppercased).
# MODE_<STAGE>=chat|fusion|web_search   TEMP_<STAGE>=0.0-1.0   MAXTOK_<STAGE>=<int>
# Example (The Grid signal stages):
# MODE_SIGNALS_DEEPDIVE=fusion
# MODE_SIGNALS_MACRO=web_search
# TEMP_STORY=0.8
# Web-search plugin defaults (used when a stage's MODE=web_search):
WEB_ENGINE=exa
WEB_MAX_RESULTS=6
